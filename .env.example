# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Used for OpenRouter models (e.g., claude-3.5-sonnet, gpt-4o-mini, deepseek-r1)
OPENROUTER_API_KEY=""

# NVIDIA_API_KEY: Used for NVIDIA NIM models (e.g., meta/llama-3.1-70b-instruct, nemotron)
NVIDIA_API_KEY=""

# GROQ_API_KEY: Used for ultra-fast free tier models (e.g., llama-3.3-70b-versatile, mixtral-8x7b-32768)
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay API Credentials (Commented out in favor of Webhook-based fulfillment)
# To use direct API calls instead of Webhooks, uncomment these and set from Razorpay Dashboard > Settings > API Keys
# VITE_RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Razorpay Webhook Secret (Recommended for actual payments)
# Configure this in Razorpay Dashboard > Settings > Webhooks (Ingress URL: https://<your-domain>/api/payments/razorpay/webhook)
# Secret is used to cryptographically verify HMAC-SHA256 signatures for payment.captured & order.paid events
RAZORPAY_WEBHOOK_SECRET=""

# GitHub & Vercel Deployment Tokens (Optional server defaults, users can also provide via secure UI)
# GitHub token with 'repo' scope from: https://github.com/settings/tokens
GITHUB_TOKEN=""

# Vercel Personal Access Token from: https://vercel.com/account/tokens
VERCEL_TOKEN=""

# Guest Profile Local Storage Key (Configurable client-side session key)
VITE_GUEST_STORAGE_KEY="devforge_guest_profile_v2"


