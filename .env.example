# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Used for OpenRouter models (e.g., claude-3.5-sonnet, gpt-4o-mini, deepseek-r1)
OPENROUTER_API_KEY=""

# NVIDIA_API_KEY: Used for NVIDIA NIM models (e.g., meta/llama-3.1-70b-instruct, nemotron)
NVIDIA_API_KEY=""

# GROQ_API_KEY: Used for ultra-fast free tier models (e.g., llama-3.3-70b-versatile, mixtral-8x7b-32768)
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay API Credentials
# Get these from Razorpay Dashboard > Settings > API Keys (Test Mode keys are perfect for sandbox testing)
VITE_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


