rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // Catalogs are public read-only. Only custom-claim admins can change prices
    // or tier definitions.
    match /plans/{planId} { allow read: if true; allow write: if isAdmin(); }
    match /templates/{templateId} { allow read: if true; allow write: if signedIn() || isAdmin(); }
    match /marketplace_products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{couponId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_pages/{pageId} { allow read: if true; allow write: if isAdmin(); }

    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      match /exports/{exportId} {
        allow create: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.userId)
          && request.resource.data.userId == request.auth.uid;
        allow read: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.userId);
        allow update, delete: if false;
      }
    }

    // These contain payment or operational metadata and are written only by a
    // trusted backend. End users may read their own non-secret records.
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /deployment_events/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
