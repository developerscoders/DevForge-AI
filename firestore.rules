rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || (request.auth.token.email == 'pallavburnwal12345@gmail.com' && request.auth.token.email_verified == true)); }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // Catalogs are public read-only. Only custom-claim admins can change prices
    // or tier definitions.
    match /plans/{planId} { allow read: if true; allow write: if isAdmin(); }
    match /templates/{templateId} { allow read: if true; allow write: if signedIn() || isAdmin(); }
    match /marketplace_products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{couponId} { allow read: if true; allow write: if isAdmin(); }
    match /cms_pages/{pageId} { allow read: if true; allow write: if isAdmin(); }

    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Generated source files are stored one document per path to avoid the
      // Firestore 1 MiB document-size limit on large projects.
      match /files/{fileId} {
        function projectOwner() {
          return signedIn() &&
            get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
        }
        allow read, create, update, delete: if projectOwner();
      }

      // Execution snapshots and individual tool records are separate documents
      // so a large run cannot overflow the parent project document's 1 MiB limit.
      match /runs/{runId} {
        function projectOwner() {
          return signedIn() &&
            get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
        }
        allow read, create, update: if projectOwner();
        allow delete: if false;

        match /tools/{toolId} {
          function projectOwner() {
            return signedIn() &&
              get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
          }
          allow read, create, update: if projectOwner();
          allow delete: if false;
        }
      }

      match /exports/{exportId} {
        allow create: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.userId)
          && request.resource.data.userId == request.auth.uid;
        allow read: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.userId);
        allow update, delete: if false;
      }
    }

    // These contain payment or operational metadata and are written only by a
    // trusted backend or authenticated owner. End users may read their own non-secret records.
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /deployment_events/{eventId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
